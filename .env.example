# Load before starting Python: set -a; . ./.env; set +a
# Set the paths you need. No parent vln checkout is required when input roots
# and per-model selection/adapter paths are supplied explicitly.
INTERVENE_MODELS_ROOT=/absolute/path/to/model-projects
INTERVENE_DATASET_ROOT=/absolute/path/to/R2R_VLNCE_v1-3_preprocessed
INTERVENE_EXPORT_ROOT=/absolute/path/to/review-exports
INTERVENE_ARCHIVE_ROOT=/absolute/path/to/result-archive
# Optional: original workspace for legacy prediction paths.
# INTERVENE_WORKSPACE_ROOT=/absolute/path/to/vln
# Optional: default report output is this repository's results/ directory.
# INTERVENE_RESULTS_ROOT=/absolute/path/to/reports
# Optional: semantic-region API credentials; use the name in api_key_env.
# OCCLUSION_API_KEY=your-local-key
